{
  "name": "scheme-finder-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express + TypeScript API for the Government Scheme Finder AI Tool",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "ts-node -r dotenv/config src/db/migrate.ts",
    "seed": "ts-node -r dotenv/config src/db/seed.ts",
    "ingest": "ts-node -r dotenv/config src/pipeline/ingest.ts"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "nanoid": "^3.3.12",
    "openai": "^6.38.0",
    "pg": "^8.13.1",
    "pgvector": "^0.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cheerio": "^1.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
